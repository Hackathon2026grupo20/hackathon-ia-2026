{
  "schema_version": "1.0",
  "rules_version": "2026-08-08.2",
  "methodology": {
    "name": "openmeteo_operational_weather_events",
    "description": "Regras operacionais para detectar sinais meteorológicos localmente incomuns e gerar candidatos a eventos contextuais.",
    "scientific_status": "operational_baseline_not_official_climatological_normal"
  },
  "temperature_baseline": {
    "enabled": true,
    "baseline_version": "1.1",
    "source": "open-meteo",
    "source_service": "historical",
    "model": "era5_land",
    "complete_years": 10,
    "grouping": "calendar_month",
    "variables": [
      "temperature_2m_max",
      "temperature_2m_min"
    ],
    "statistics": [
      "mean",
      "p05",
      "p10",
      "p90",
      "p95"
    ],
    "percentile_method": "linear_interpolation_n_minus_1",
    "percentiles": [
      0.05,
      0.1,
      0.9,
      0.95
    ],
    "minimum_samples_per_month": 250
  },
  "temperature_events": {
    "unusually_hot_day": {
      "enabled": true,
      "family": "heat",
      "severity": "moderate",
      "priority": 10,
      "metric": "temperature_2m_max",
      "operator": "greater_than_or_equal",
      "percentile": "p90",
      "minimum_consecutive_days": 1
    },
    "extreme_heat_day": {
      "enabled": true,
      "family": "heat",
      "severity": "severe",
      "priority": 20,
      "metric": "temperature_2m_max",
      "operator": "greater_than_or_equal",
      "percentile": "p95",
      "anomaly_reference": "mean",
      "anomaly_operator": "greater_than_or_equal",
      "anomaly_threshold_c": 3.0,
      "minimum_consecutive_days": 1
    },
    "heat_wave_candidate": {
      "enabled": true,
      "family": "heat",
      "severity": "extreme",
      "priority": 30,
      "metric": "temperature_2m_max",
      "operator": "greater_than_or_equal",
      "percentile": "p90",
      "anomaly_reference": "mean",
      "anomaly_operator": "greater_than_or_equal",
      "anomaly_threshold_c": 5.0,
      "minimum_consecutive_days": 5,
      "warm_night_metric": "temperature_2m_min",
      "warm_night_percentile": "p90"
    },
    "unusually_cold_day": {
      "enabled": true,
      "family": "cold",
      "severity": "moderate",
      "priority": 10,
      "metric": "temperature_2m_min",
      "operator": "less_than_or_equal",
      "percentile": "p10",
      "minimum_consecutive_days": 1
    },
    "extreme_cold_day": {
      "enabled": true,
      "family": "cold",
      "severity": "severe",
      "priority": 20,
      "metric": "temperature_2m_min",
      "operator": "less_than_or_equal",
      "percentile": "p05",
      "anomaly_reference": "mean",
      "anomaly_operator": "less_than_or_equal",
      "anomaly_threshold_c": -3.0,
      "minimum_consecutive_days": 1
    },
    "cold_wave_candidate": {
      "enabled": true,
      "family": "cold",
      "severity": "extreme",
      "priority": 30,
      "metric": "temperature_2m_min",
      "operator": "less_than_or_equal",
      "percentile": "p10",
      "anomaly_reference": "mean",
      "anomaly_operator": "less_than_or_equal",
      "anomaly_threshold_c": -3.0,
      "minimum_consecutive_days": 3
    }
  },
  "precipitation_events": {
    "heavy_rain_day": {
      "enabled": true,
      "family": "precipitation",
      "severity": "severe",
      "priority": 10,
      "metric": "precipitation_sum",
      "operator": "greater_than_or_equal",
      "threshold": 50.0,
      "unit": "mm/day"
    },
    "extreme_rain_day": {
      "enabled": true,
      "family": "precipitation",
      "severity": "extreme",
      "priority": 20,
      "metric": "precipitation_sum",
      "operator": "greater_than_or_equal",
      "threshold": 100.0,
      "unit": "mm/day"
    }
  },
  "wind_events": {
    "strong_wind_day": {
      "enabled": true,
      "family": "wind",
      "severity": "moderate",
      "priority": 10,
      "metric": "wind_gusts_10m_max",
      "operator": "greater_than_or_equal",
      "threshold": 60.0,
      "unit": "km/h"
    },
    "severe_wind_day": {
      "enabled": true,
      "family": "wind",
      "severity": "severe",
      "priority": 20,
      "metric": "wind_gusts_10m_max",
      "operator": "greater_than_or_equal",
      "threshold": 80.0,
      "unit": "km/h"
    },
    "extreme_wind_day": {
      "enabled": true,
      "family": "wind",
      "severity": "extreme",
      "priority": 30,
      "metric": "wind_gusts_10m_max",
      "operator": "greater_than_or_equal",
      "threshold": 100.0,
      "unit": "km/h"
    }
  },
  "storm_events": {
    "storm_candidate": {
      "enabled": true,
      "family": "storm",
      "severity": "severe",
      "priority": 40,
      "forecast_weather_codes": [
        95,
        96,
        99
      ],
      "use_weather_code_only_for_forecast": true,
      "minimum_precipitation_mm": 30.0,
      "minimum_wind_gust_kmh": 60.0,
      "compound_operator": "and",
      "detection_logic": "forecast_weather_code_or_daily_rain_and_wind",
      "temporal_resolution": "daily",
      "simultaneity_confirmed": false
    }
  }
}
