# Never commit your real token.
# The code also reads ~/.cdsapirc automatically.
CDSAPI_KEY=your-cds-api-token

# Historical router. AUTO uses ARCO directly.
PREDICTA_CLIMATE_HISTORICAL_MODE=auto

# Optional compatibility hook for an existing legacy Open-Meteo historical runner.
